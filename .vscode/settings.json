{
  // TASK-0005 · TASK-0100 (m3) — настройки workspace (не глобальные prefs).
  "editor.formatOnSave": false,
  "editor.tabSize": 2,
  "files.eol": "\n",

  // Пакет EdgeExtension/ — чистый Vanilla JS: не предлагать сборку/форматирование.
  "files.associations": {
    "*.ps1": "powershell"
  },

  // Не наблюдать тяжёлые каталоги (скорость файлового наблюдателя).
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.edge-cdp-profile/**": true
  },

  // Поиск не заходит в артефакты и профиль Edge.
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.edge-cdp-profile": true,
    "**/package-lock.json": true
  }
}
