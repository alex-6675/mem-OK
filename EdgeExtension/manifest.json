{
  "manifest_version": 3,
  "name": "Записки ОК",
  "description": "Записка на карточку ОК: ПЕР/СОО → картотека → база (файл-первый).",
  "default_locale": "ru",
  "action": {},
  "version": "0.2.0",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ok.ru/*"
      ],
      "js": [
        "src/core/messaging.js",
        "src/core/normalize.js",
        "src/core/storage.js",
        "src/core/slonstore.js",
        "src/ui/layer.js",
        "src/ui/slonmarks.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ok.ru/*"
  ]
}
